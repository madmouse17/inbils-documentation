---
import { Image } from 'astro:assets';
import shot from '../../assets/guide/web/platform-dashboard.webp';
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const points = ['plat.b1', 'plat.b2', 'plat.b3', 'plat.b4'] as const;
---

<section
  id="platform"
  aria-labelledby="plat-title"
  class="mt-24 bg-surface-2 py-20 lg:mt-32 lg:py-28"
>
  <div class="mx-auto max-w-300 px-5">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <figure class="shot lg:col-span-7">
        <Image
          src={shot}
          alt={t(lang, 'plat.shotAlt')}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1240px) 700px, (min-width: 64rem) 58vw, calc(100vw - 2.5rem)"
          loading="lazy"
        />
      </figure>
      <div class="lg:col-span-5">
        <h2 id="plat-title" class="text-section font-semibold">
          {t(lang, 'plat.title')}
        </h2>
        <p class="mt-5 text-lg text-muted">{t(lang, 'plat.lede')}</p>
        <ul class="points mt-8">
          {points.map((key) => (
            <li>{t(lang, key)}</li>
          ))}
        </ul>
        <a href={href(lang, '/docs/guides/platform/')} class="link mt-8 inline-block">
          {t(lang, 'plat.link')}
        </a>
      </div>
    </div>
  </div>
</section>
