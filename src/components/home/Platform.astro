---
import { href, t, type Lang } from '../../lib/i18n';
import SceneFrame from './SceneFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const points = ['plat.b1', 'plat.b2', 'plat.b3', 'plat.b4'] as const;
---

<section
  id="platform"
  aria-labelledby="plat-title"
  class="mt-24 bg-surface-2 py-20 lg:mt-32 lg:py-28"
>
  <div class="mx-auto max-w-300 px-5">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <SceneFrame
        name="tenants"
        ratio="4 / 3"
        ratioNarrow="1 / 1"
        caption={t(lang, 'scene.tenants.caption')}
        class="lg:col-span-7"
      >
        <!-- The turn of the view is a slider: the arrow keys do what a drag does. -->
        <div
          class="turn"
          role="slider"
          tabindex="0"
          aria-label={t(lang, 'scene.tenants.label')}
          aria-orientation="horizontal"
          aria-valuemin="0"
          aria-valuemax="359"
          aria-valuenow="20"
        >
          <canvas aria-hidden="true" data-name={t(lang, 'scene.tenants.name')}></canvas>
        </div>
      </SceneFrame>
      <div class="lg:col-span-5">
        <h2 id="plat-title" class="text-section font-semibold">
          {t(lang, 'plat.title')}
        </h2>
        <p class="mt-5 text-lg text-muted">{t(lang, 'plat.lede')}</p>
        <ul class="points mt-8">
          {points.map((key) => (
            <li>{t(lang, key)}</li>
          ))}
        </ul>
        <a href={href(lang, '/docs/guides/platform/')} class="link mt-8 inline-block">
          {t(lang, 'plat.link')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .turn {
    position: absolute;
    inset: 0;
    cursor: grab;
    /* A vertical swipe still scrolls the page; a horizontal drag turns the view. */
    touch-action: pan-y;
  }
  .turn:active {
    cursor: grabbing;
  }
  /* The ring sits inside the frame, which clips anything outside it. */
  .turn:focus-visible {
    outline-offset: -4px;
    border-radius: var(--radius-lg);
  }
</style>
