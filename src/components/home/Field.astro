---
import { Icon } from 'astro-icon/components';
import { href, t, type Lang } from '../../lib/i18n';
import { MAP, mapArt } from '../../lib/map-art';
import SceneFrame from './SceneFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const points = ['field.b1', 'field.b2', 'field.b3', 'field.b4'] as const;

// The field scene (src/scripts/scenes/field.ts): a street map, the technician's route and the four steps of a
// visit. The map is server-rendered; the script moves the pin and switches classes.
const art = mapArt();
const pct = (value: number, of: number): string => `${((value / of) * 100).toFixed(2)}%`;
const steps = ['assigned', 'travel', 'working', 'done'] as const;
---

<section id="field" aria-labelledby="field-title" class="mx-auto max-w-300 px-5 pt-24 lg:pt-32">
  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:order-2 lg:col-span-5 lg:col-start-8">
      <h2 id="field-title" class="max-w-[24ch] text-section font-semibold">
        {t(lang, 'field.title')}
      </h2>
      <p class="mt-5 max-w-[62ch] text-lg text-muted">{t(lang, 'field.lede')}</p>
      <ul class="points mt-8 max-w-[62ch]">
        {points.map((key) => (
          <li>{t(lang, key)}</li>
        ))}
      </ul>
      <a href={href(lang, '/docs/guides/technician/work-orders/')} class="link mt-8 inline-block">
        {t(lang, 'field.link')}
      </a>
    </div>

    <SceneFrame
      name="field"
      ratio="5 / 4"
      caption={t(lang, 'scene.field.caption')}
      class="lg:order-1 lg:col-span-7"
    >
      <svg
        class="map"
        viewBox={`0 0 ${MAP.w} ${MAP.h}`}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <rect class="land" width={MAP.w} height={MAP.h}></rect>
        {art.blocks.map((b) => (
          <rect
            class={b.park ? 'park' : 'building'}
            x={b.x}
            y={b.y}
            width={b.w}
            height={b.h}
            rx="5"
          ></rect>
        ))}
        {art.trees.map(([x, y]) => (
          <circle class="tree" cx={x} cy={y} r="3.2"></circle>
        ))}
        {art.roads.map((d) => (
          <path class="road" d={d}></path>
        ))}
        {art.roads.map((d) => (
          <path class="lane" d={d}></path>
        ))}
        <circle
          class="fence"
          data-fence
          cx={art.customer[0]}
          cy={art.customer[1]}
          r={art.radius}
        ></circle>
        <path class="route" d={art.route}></path>
        <path class="trail" data-trail d={art.route}></path>
        <g transform={`translate(${art.office[0]} ${art.office[1]})`}>
          <rect class="place" x="-11" y="-11" width="22" height="22" rx="5"></rect>
          <path class="glyph" d="M-6,5V-5H6V5ZM-6,-1H6M-2,5V1H2V5"></path>
        </g>
        <g transform={`translate(${art.customer[0]} ${art.customer[1]})`}>
          <rect class="place house" data-house x="-12" y="-12" width="24" height="24" rx="6"></rect>
          <path class="glyph" d="M-6,4V-1L0,-6L6,-1V4ZM-2,4V1H2V4"></path>
        </g>
        <g transform={`translate(${art.customer[0]} ${art.customer[1]})`}>
          <circle class="ripple" data-ripple r="10"></circle>
          <circle class="ripple second" data-ripple r="10"></circle>
        </g>
        <g class="pin" data-pin>
          <ellipse class="pin-shadow" cx="0" cy="0" rx="7" ry="2.6"></ellipse>
          <path
            class="pin-body"
            d="M0,0C-3,-8,-11,-13,-11,-21a11,11 0 1 1 22,0C11,-13,3,-8,0,0Z"
          ></path>
          <circle class="pin-dot" cx="0" cy="-21" r="4.4"></circle>
        </g>
      </svg>

      <span
        class="tag"
        style={`left: ${pct(art.office[0], MAP.w)}; top: ${pct(art.office[1] + 15, MAP.h)}`}
      >
        {t(lang, 'scene.field.office')}
      </span>
      <span
        class="tag"
        style={`left: ${pct(art.customer[0], MAP.w)}; top: ${pct(art.customer[1] + 15, MAP.h)}`}
      >
        {t(lang, 'scene.field.customer')}
      </span>
      <span
        class="tag radius"
        style={`left: ${pct(art.customer[0] - art.radius * 0.72, MAP.w)}; top: ${pct(art.customer[1] + art.radius * 0.72, MAP.h)}`}
      >
        500 m
      </span>

      <div class="steps">
        <ol aria-label={t(lang, 'scene.field.steps')}>
          {steps.map((step) => (
            <li data-step={step}>
              <span class="dot"></span>
              <span class="name">{t(lang, `scene.field.${step}`)}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="evidence" data-evidence>
        <p class="title">
          <Icon name="ph:camera" class="size-4" aria-hidden="true" />
          {t(lang, 'scene.field.evidence')}
        </p>
        <div class="photos" aria-hidden="true">
          <span class="photo one">
            <svg viewBox="0 0 40 30">
              <rect x="8" y="12" width="24" height="12" rx="2"></rect>
              <path d="M13,18h2M18,18h2M23,18h2"></path>
              <path d="M14,12V8M26,12V8"></path>
            </svg>
          </span>
          <span class="photo two">
            <svg viewBox="0 0 40 30">
              <path d="M6,24L20,8L34,24Z"></path>
              <path d="M14,24V17H26V24"></path>
            </svg>
          </span>
        </div>
        <p class="meta">{t(lang, 'scene.field.material')}</p>
        <p class="approved">
          <Icon name="ph:check-circle" class="size-4" aria-hidden="true" />
          {t(lang, 'scene.field.approved')}
        </p>
      </div>
    </SceneFrame>
  </div>
</section>

<style>
  .map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .land {
    fill: var(--surface-2);
  }
  .building {
    fill: rgb(var(--ink-rgb) / 0.07);
  }
  .park {
    fill: rgb(var(--net-signal-rgb) / 0.18);
  }
  .tree {
    fill: rgb(var(--net-signal-rgb) / 0.4);
  }
  .road {
    fill: none;
    stroke: var(--surface);
    stroke-width: 12;
  }
  .lane {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 5 6;
  }
  .fence {
    fill: rgb(var(--net-rgb) / 0);
    stroke: rgb(var(--net-rgb) / 0.75);
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
    transition: fill 400ms ease;
  }
  .fence.in {
    fill: rgb(var(--net-rgb) / 0.12);
  }
  .route {
    fill: none;
    stroke: rgb(var(--net-rgb) / 0.4);
    stroke-width: 2;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trail {
    fill: none;
    stroke: rgb(var(--net-rgb));
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .place {
    fill: var(--surface);
    stroke: var(--outline);
    stroke-width: 1.4;
  }
  .glyph {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .house {
    transition:
      fill 400ms ease,
      stroke 400ms ease;
  }
  .house.on {
    fill: rgb(var(--net-signal-rgb) / 0.35);
    stroke: rgb(var(--net-signal-rgb));
  }
  .ripple {
    fill: none;
    stroke: rgb(var(--net-signal-rgb));
    stroke-width: 2;
    opacity: 0;
  }
  .ripple.go {
    animation: ripple 1.3s ease-out both;
  }
  .ripple.second.go {
    animation-delay: 0.35s;
  }
  @keyframes ripple {
    from {
      r: 10px;
      opacity: 0.9;
    }
    to {
      r: 52px;
      opacity: 0;
    }
  }
  .pin-shadow {
    fill: rgb(var(--ink-rgb) / 0.22);
  }
  .pin-body {
    fill: var(--accent);
    stroke: var(--surface);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .pin-dot {
    fill: var(--on-accent);
  }

  .tag {
    position: absolute;
    translate: -50% 0;
    padding: 0.0625rem 0.375rem;
    border-radius: 0.25rem;
    background: var(--surface);
    color: var(--fg);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
  }
  .tag.radius {
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }

  /* The four steps: dots joined by a line, and only the current step's name shown; the others stay in the
     accessibility tree. */
  .steps {
    position: absolute;
    left: 3%;
    top: 4%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .steps ol {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .steps li:not(:last-child)::after {
    content: '';
    width: 1rem;
    height: 2px;
    background: var(--line);
  }
  .dot {
    width: 0.625rem;
    height: 0.625rem;
    border: 2px solid var(--outline);
    border-radius: 50%;
    background: var(--surface);
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }
  .steps li.past .dot {
    background: var(--outline);
  }
  .steps li.now .dot {
    border-color: var(--accent-text);
    background: var(--accent);
  }
  .steps .name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .steps li.now .name {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
    color: var(--fg);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .evidence {
    position: absolute;
    left: 3%;
    top: 22%;
    display: grid;
    gap: 0.375rem;
    width: min(42%, 13rem);
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--outline);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 10px 24px -14px rgb(var(--ink-rgb) / 0.5);
    opacity: 0;
    translate: 0 8px;
    scale: 0.96;
    transform-origin: top left;
    transition:
      opacity 260ms ease,
      translate 260ms ease,
      scale 260ms ease;
    pointer-events: none;
  }
  .evidence.in {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  .evidence .title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .photos {
    display: flex;
    gap: 0.375rem;
  }
  .photo {
    display: grid;
    place-items: center;
    width: 2.75rem;
    aspect-ratio: 4 / 3;
    border-radius: 0.25rem;
    background: var(--surface-2);
    opacity: 0;
    scale: 0.85;
    transition:
      opacity 220ms ease,
      scale 220ms ease;
  }
  .evidence.in .photo.one,
  .evidence.two .photo.two {
    opacity: 1;
    scale: 1;
  }
  .evidence.two .photo.two {
    transition-delay: 120ms;
  }
  .photo svg {
    width: 1.5rem;
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .meta {
    color: var(--fg-muted);
    font-size: 0.75rem;
    line-height: 1.3;
  }
  .approved {
    display: none;
    align-items: center;
    gap: 0.375rem;
    color: var(--accent-text);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .evidence.ok .approved {
    display: flex;
  }

  /* The scene fades out before it starts over, so the reset is not seen. */
  .pin,
  .trail,
  .steps {
    transition: opacity 500ms ease;
  }
  :global(.scene.leaving) .pin,
  :global(.scene.leaving) .trail,
  :global(.scene.leaving) .evidence,
  :global(.scene.leaving) .steps {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .fence,
    .house,
    .dot,
    .evidence,
    .photo {
      transition: none;
    }
  }
</style>
