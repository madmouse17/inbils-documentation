---
import { Icon } from 'astro-icon/components';
import { href, t, type Lang } from '../../lib/i18n';
import SceneFrame from './SceneFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const points = ['bill.b1', 'bill.b2', 'bill.b3', 'bill.b4'] as const;

// The billing scene (src/scripts/scenes/billing.ts): the payment methods the customer sees, Midtrans, an invoice
// that turns paid, and the ledger of receipts. The methods are the ones the customer app lists; the amount and
// the package are the example values of the app's demo data.
const methods = [
  { id: 'qris', icon: 'ph:qr-code', label: t(lang, 'scene.bill.qris') },
  { id: 'va', icon: 'ph:bank', label: t(lang, 'scene.bill.va') },
  { id: 'wallet', icon: 'ph:wallet', label: t(lang, 'scene.bill.wallet') },
  { id: 'store', icon: 'ph:storefront', label: t(lang, 'scene.bill.store') },
] as const;
---

<section id="billing" aria-labelledby="bill-title" class="mx-auto max-w-300 px-5 pt-24 lg:pt-32">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 id="bill-title" class="text-section font-semibold">
        {t(lang, 'bill.title')}
      </h2>
      <p class="mt-5 text-lg text-muted">{t(lang, 'bill.lede')}</p>
    </div>
    <div class="lg:col-span-6 lg:col-start-7">
      <ul class="points">
        {points.map((key) => (
          <li>{t(lang, key)}</li>
        ))}
      </ul>
      <a
        href={href(lang, '/docs/guides/web/finance-and-reports/invoices/')}
        class="link mt-8 inline-block"
      >
        {t(lang, 'bill.link')}
      </a>
    </div>
  </div>

  <SceneFrame
    name="billing"
    ratio="3 / 1"
    ratioNarrow="3 / 5"
    caption={t(lang, 'scene.bill.caption')}
    class="mt-14"
  >
    <div class="flow">
      <canvas class="pipes" aria-hidden="true"></canvas>

      <div class="methods" role="group" aria-label={t(lang, 'scene.bill.methods')}>
        {methods.map((m) => (
          <button type="button" class="method" data-method={m.id} data-label={m.label}>
            <Icon name={m.icon} class="size-5" aria-hidden="true" />
            {m.label}
          </button>
        ))}
      </div>

      <div class="hub" data-hub aria-hidden="true">
        <Icon name="ph:shield-check" class="size-6" aria-hidden="true" />
        <span>Midtrans</span>
      </div>

      <div class="invoice" data-invoice>
        <div class="card" data-card>
          <div class="face front" data-front>
            <p class="head">
              <span>{t(lang, 'scene.bill.invoice')}</span>
              <span class="badge">
                <Icon name="ph:clock" class="size-4" aria-hidden="true" />
                {t(lang, 'scene.bill.unpaid')}
              </span>
            </p>
            <p class="plan">Home 10Mbps</p>
            <p class="amount">Rp 150.000</p>
          </div>
          <div class="face back" data-back aria-hidden="true">
            <p class="head">
              <span>{t(lang, 'scene.bill.receipt')}</span>
              <span class="badge paid">
                <Icon name="ph:check-circle" class="size-4" aria-hidden="true" />
                {t(lang, 'scene.bill.paid')}
              </span>
            </p>
            <p class="plan">
              {t(lang, 'scene.bill.via')} <strong data-via>QRIS</strong>
            </p>
            <p class="amount">Rp 150.000</p>
          </div>
        </div>
        <span class="ring" data-ring aria-hidden="true"></span>
      </div>

      <div class="ledger" data-ledger aria-hidden="true">
        <p class="note">{t(lang, 'scene.bill.ledger')}</p>
        {[0, 1, 2, 3].map((slot) => (
          <div class="receipt" data-receipt={slot} data-pos={slot}>
            <Icon name="ph:check-circle" class="size-4" aria-hidden="true" />
            <span data-receipt-label>{methods[slot].label}</span>
          </div>
        ))}
      </div>
    </div>
    <p
      class="sr-only"
      aria-live="polite"
      data-status
      data-prefix={t(lang, 'scene.bill.status')}
    ></p>
  </SceneFrame>
</section>

<style>
  .flow {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-items: center;
    align-content: center;
    justify-items: center;
    padding: 1.5rem 1.25rem;
  }
  @media (min-width: 40rem) {
    .flow {
      grid-template-columns: minmax(8.5rem, 1fr) 5.25rem minmax(15rem, 1.7fr) minmax(9rem, 1fr);
      gap: 1.25rem;
      padding: 1.5rem 2rem;
    }
  }
  .methods,
  .hub,
  .invoice,
  .ledger {
    position: relative;
    z-index: 1;
  }
  .pipes {
    z-index: 0;
  }

  .methods {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    width: 100%;
  }
  @media (min-width: 40rem) {
    .methods {
      grid-template-columns: 1fr;
      justify-self: start;
      max-width: 11rem;
    }
  }
  .method {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--outline);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .method:hover {
    border-color: var(--fg);
  }
  .method.active {
    border-color: var(--accent-text);
    background: color-mix(in srgb, rgb(var(--net-rgb)) 14%, var(--surface));
  }

  .hub {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 0.625rem 0.5rem;
    border: 1px solid var(--outline);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .hub :global(svg) {
    color: var(--accent-text);
  }

  /* The card flips about its vertical axis; both faces keep a little tilt so it reads as an object, not a panel. */
  .invoice {
    width: min(100%, 22rem);
    aspect-ratio: 1.75;
    perspective: 1100px;
  }
  .card {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(7deg) rotateY(-10deg);
    transition: transform 800ms cubic-bezier(0.3, 0.1, 0.2, 1);
  }
  .card.paid {
    transform: rotateX(7deg) rotateY(170deg);
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: space-between;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
    backface-visibility: hidden;
  }
  .face.back {
    transform: rotateY(180deg);
    background: color-mix(in srgb, rgb(var(--net-signal-rgb)) 10%, var(--surface));
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--outline);
    border-radius: 0.375rem;
    color: var(--fg);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .badge.paid {
    border-color: rgb(var(--net-signal-rgb));
  }
  .plan {
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }
  .plan strong {
    color: var(--fg);
    font-weight: 600;
  }
  .amount {
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .ring {
    position: absolute;
    inset: -4%;
    border: 2px solid rgb(var(--net-signal-rgb));
    border-radius: var(--radius-lg);
    opacity: 0;
    pointer-events: none;
  }
  .ring.go {
    animation: ring 900ms ease-out both;
  }
  @keyframes ring {
    from {
      opacity: 0.9;
      scale: 0.96;
    }
    to {
      opacity: 0;
      scale: 1.12;
    }
  }

  /* The ledger lists the latest receipts, newest on top. Four receipts are reused: the newest takes the top row,
     the others move down a row, and the oldest fades out. */
  .ledger {
    justify-self: center;
    width: min(100%, 12rem);
    height: 9.5rem;
  }
  @media (min-width: 40rem) {
    .ledger {
      justify-self: end;
    }
  }
  .note {
    color: var(--fg-muted);
    font-size: 0.75rem;
    line-height: 1.3;
  }
  .receipt {
    position: absolute;
    left: 0;
    top: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.4375rem 0.75rem;
    border: 1px solid var(--outline);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      translate 500ms ease,
      opacity 500ms ease;
  }
  .receipt :global(svg) {
    color: rgb(var(--net-signal-rgb));
  }
  .receipt[data-pos='1'] {
    translate: 0 2.5rem;
    opacity: 0.8;
  }
  .receipt[data-pos='2'] {
    translate: 0 5rem;
    opacity: 0.55;
  }
  .receipt[data-pos='3'] {
    translate: 0 7.5rem;
    opacity: 0;
  }
  .receipt.fresh {
    animation: receipt-in 600ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes receipt-in {
    from {
      translate: -2.5rem -0.5rem;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .receipt,
    .method {
      transition: none;
    }
  }
</style>
