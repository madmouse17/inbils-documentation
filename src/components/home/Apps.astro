---
import { Image } from 'astro:assets';
import technician from '../../assets/guide/technician/beranda.webp';
import customer from '../../assets/guide/customer/redesign/beranda-blue-light.webp';
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const points = ['apps.b1', 'apps.b2', 'apps.b3'] as const;
const guides = [
  { label: t(lang, 'apps.guideCustomer'), to: '/docs/guides/customer/' },
  { label: t(lang, 'apps.guideTechnician'), to: '/docs/guides/technician/' },
  { label: t(lang, 'apps.guideApi'), to: '/docs/api/' },
];
---

<section id="apps" aria-labelledby="apps-title" class="mx-auto max-w-300 px-5 pt-24 lg:pt-32">
  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 id="apps-title" class="max-w-[22ch] text-section font-semibold">
        {t(lang, 'apps.title')}
      </h2>
      <p class="mt-5 max-w-[62ch] text-lg text-muted">{t(lang, 'apps.lede')}</p>
      <ul class="points mt-8 max-w-[62ch]">
        {points.map((key) => (
          <li>{t(lang, key)}</li>
        ))}
      </ul>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-1">
        {guides.map((g) => (
          <li>
            <a href={href(lang, g.to)} class="link inline-flex min-h-11 items-center">
              {g.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- The two real apps, side by side in perspective. They float, and lean toward the pointer (apps.ts). -->
    <div class="phones lg:col-span-5" data-scene="apps">
      <div class="tilt">
        <figure class="phone back">
          <Image
            src={technician}
            alt={t(lang, 'apps.shotAltTech')}
            widths={[300, 600]}
            sizes="(min-width: 64rem) 220px, 42vw"
            loading="lazy"
          />
        </figure>
        <figure class="phone front">
          <Image
            src={customer}
            alt={t(lang, 'apps.shotAlt')}
            widths={[300, 600]}
            sizes="(min-width: 64rem) 220px, 42vw"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .phones {
    position: relative;
    justify-self: center;
    width: min(100%, 26rem);
    aspect-ratio: 1 / 1.08;
    perspective: 1400px;
  }
  .tilt {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  }
  /* A phone: a dark bezel around the capture, whose status bar is cut off (the captures come from debug builds). */
  .phone {
    position: absolute;
    width: 53%;
    aspect-ratio: 1080 / 2230;
    overflow: hidden;
    border: 0.4rem solid #0b1222;
    border-radius: 1.75rem;
    background: #0b1222;
    box-shadow: var(--shadow-lift);
  }
  .phone :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
    border-radius: 1.3rem;
  }
  .back {
    left: 2%;
    top: 0;
    transform: translateZ(-50px) rotateY(18deg) rotateZ(-3deg) scale(0.93);
    animation: float 8s ease-in-out infinite alternate;
  }
  .front {
    right: 2%;
    bottom: 0;
    transform: translateZ(40px) rotateY(-12deg) rotateZ(2deg);
    animation: float 7s ease-in-out -3s infinite alternate;
  }
  /* `translate` composes with `transform`, so the float and the tilt do not fight. */
  @keyframes float {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -0.7rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .back,
    .front {
      animation: none;
    }
  }
</style>
