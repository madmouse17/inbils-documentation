---
import { Icon } from 'astro-icon/components';
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// The five stations of one customer, each with the chapter of the web guide that covers it. The icons are the
// things themselves: a person, a work order, a network, an invoice, a help desk.
const stations = [
  {
    icon: 'ph:user-circle',
    title: t(lang, 'life.customer'),
    body: t(lang, 'life.customerBody'),
    to: '/docs/guides/web/customers-and-services/customers/',
  },
  {
    icon: 'ph:clipboard-text',
    title: t(lang, 'life.order'),
    body: t(lang, 'life.orderBody'),
    to: '/docs/guides/web/operations/work-orders/',
  },
  {
    icon: 'ph:hard-drives',
    title: t(lang, 'life.network'),
    body: t(lang, 'life.networkBody'),
    to: '/docs/guides/web/network/nas-routers/',
  },
  {
    icon: 'ph:receipt',
    title: t(lang, 'life.billing'),
    body: t(lang, 'life.billingBody'),
    to: '/docs/guides/web/finance-and-reports/invoices/',
  },
  {
    icon: 'ph:headset',
    title: t(lang, 'life.support'),
    body: t(lang, 'life.supportBody'),
    to: '/docs/guides/web/operations/tickets/',
  },
];
---

<section
  id="lifecycle"
  data-scene="reveal"
  aria-labelledby="life-title"
  class="mx-auto max-w-300 px-5 pt-24 lg:pt-32"
>
  <h2 id="life-title" class="max-w-[22ch] text-section font-semibold">
    {t(lang, 'life.title')}
  </h2>
  <p class="mt-5 max-w-[62ch] text-lg text-muted">{t(lang, 'life.lede')}</p>

  <ol class="stations mt-14" aria-label={t(lang, 'life.nav')}>
    {stations.map((s, i) => (
      <li data-reveal style={`--i: ${i}`}>
        <span class="node">
          <Icon name={s.icon} class="size-6" aria-hidden="true" />
        </span>
        <div class="text">
          <h3 class="text-xl font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-2 text-muted">{s.body}</p>
          <a href={href(lang, s.to)} class="link mt-3 inline-block">
            {t(lang, 'life.read')}
            <span class="sr-only">: {s.title}</span>
          </a>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Stations along one line, like nodes along a link: the line runs down the left on small screens. The grey line
     is the empty track; each station draws the stretch to the next one (`li::after`) as it comes into view, and a
     small signal, the customer's record, rides along it (`li::before`). Without script, or under reduced motion,
     the line is simply drawn. */
  .stations {
    position: relative;
    display: grid;
    gap: 2.5rem;
  }
  .stations::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    bottom: 1.75rem;
    left: 1.75rem;
    width: 1px;
    background: var(--outline);
  }
  .stations li {
    --d: 0s;
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    column-gap: 1.25rem;
  }
  .stations li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.75rem;
    top: 3.5rem;
    width: 2px;
    height: calc(100% - 1rem);
    margin-left: -1px;
    background: var(--accent-text);
    transform-origin: top;
  }
  .stations li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.75rem;
    top: 3.5rem;
    z-index: 1;
    width: 0.625rem;
    height: 0.625rem;
    margin: -0.3125rem 0 0 -0.3125rem;
    border-radius: 50%;
    background: rgb(var(--net-signal-rgb));
    opacity: 0;
  }
  .node {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--accent-text);
    border-radius: 50%;
    background: var(--surface);
    color: var(--accent-text);
  }
  @media (min-width: 64rem) {
    .stations {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.75rem;
    }
    .stations::before {
      top: 1.75rem;
      bottom: auto;
      left: 1.75rem;
      right: 1.75rem;
      width: auto;
      height: 1px;
    }
    .stations li {
      --d: calc(var(--i) * 0.45s);
      display: block;
    }
    .stations li:not(:last-child)::after {
      left: 3.5rem;
      top: 1.75rem;
      width: calc(100% - 1.75rem);
      height: 2px;
      margin: -1px 0 0;
      transform-origin: left;
    }
    .stations li:not(:last-child)::before {
      left: 3.5rem;
      top: 1.75rem;
    }
    .text {
      margin-top: 1.25rem;
    }
  }

  /* The hidden first state exists only with script (the `js` class on <html>), and each station leaves it once. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .stations li:not(.is-in) .node {
      border-color: var(--outline);
      color: var(--fg-muted);
    }
    :global(html.js) .stations li:not(.is-in) .text {
      opacity: 0;
      translate: 0 14px;
    }
    :global(html.js) .stations li:not(.is-in)::after {
      transform: scaleY(0);
    }
    :global(html.js) .stations li.is-in .node {
      transition:
        border-color 300ms ease var(--d),
        color 300ms ease var(--d);
    }
    :global(html.js) .stations li.is-in .text {
      transition:
        opacity 600ms ease calc(var(--d) + 120ms),
        translate 600ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--d) + 120ms);
    }
    :global(html.js) .stations li.is-in::after {
      transition: transform 650ms cubic-bezier(0.4, 0, 0.2, 1) calc(var(--d) + 200ms);
    }
    :global(html.js) .stations li.is-in:not(:last-child)::before {
      animation: hop-down 650ms cubic-bezier(0.4, 0, 0.2, 1) calc(var(--d) + 200ms) both;
    }
    @media (min-width: 64rem) {
      :global(html.js) .stations li:not(.is-in)::after {
        transform: scaleX(0);
      }
      :global(html.js) .stations li.is-in:not(:last-child)::before {
        animation-name: hop-across;
      }
    }
  }
  @keyframes hop-down {
    from {
      opacity: 1;
      top: 3.5rem;
    }
    88% {
      opacity: 1;
    }
    to {
      opacity: 0;
      top: calc(100% + 2.5rem);
    }
  }
  @keyframes hop-across {
    from {
      opacity: 1;
      left: 3.5rem;
    }
    88% {
      opacity: 1;
    }
    to {
      opacity: 0;
      left: calc(100% + 1.75rem);
    }
  }
</style>
