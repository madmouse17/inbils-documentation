---
import { href, t, type Lang } from '../../lib/i18n';
import { routerArt } from '../../lib/router-art';
import SceneFrame from './SceneFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const points = ['net.b1', 'net.b2', 'net.b3', 'net.b4', 'net.b5'] as const;

// The router scene (src/scripts/scenes/router.ts): a MikroTik-style case in isometric view, a RADIUS server, and
// six subscribers, each wired to one port (ether2 to ether7). Positions are shares of the stage, so the scene
// scales with its box; the houses sit in a row under the ports so the cables fan out without crossing.
const art = routerArt();
const subscribers = Array.from({ length: 6 }, (_, i) => ({
  port: i + 1,
  left: 10 + i * 13.2,
  top: i % 2 ? 83 : 80,
}));
---

<section id="network" aria-labelledby="net-title" class="mx-auto max-w-300 px-5 pt-24 lg:pt-32">
  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 id="net-title" class="text-section font-semibold">
        {t(lang, 'net.title')}
      </h2>
      <p class="mt-5 text-lg text-muted">{t(lang, 'net.lede')}</p>
      <ul class="points mt-8">
        {points.map((key) => (
          <li>{t(lang, key)}</li>
        ))}
      </ul>
      <a href={href(lang, '/docs/guides/web/network/nas-routers/')} class="link mt-8 inline-block">
        {t(lang, 'net.link')}
      </a>
    </div>

    <SceneFrame
      name="router"
      ratio="4 / 3"
      ratioNarrow="1 / 1"
      caption={t(lang, 'scene.router.caption')}
      class="lg:col-span-7"
    >
      <div class="router" style={`aspect-ratio: ${art.ratio}`}>
        <svg viewBox={art.viewBox} aria-hidden="true" focusable="false">
          <polygon class="shadow" points={art.shadow}></polygon>
          <polygon class="face top" points={art.top}></polygon>
          <polygon class="face front" points={art.front}></polygon>
          <polygon class="face side" points={art.side}></polygon>
          <polygon class="plate" points={art.plate}></polygon>
          {art.vents.map((points) => (
            <polygon class="vent" points={points}></polygon>
          ))}
          {art.ports.map((port, i) => (
            <g class="slot" data-slot={i}>
              <polygon class="bezel" points={port.bezel}></polygon>
              <polygon class="socket" points={port.socket}></polygon>
              <polygon class="led link" points={port.link}></polygon>
              <polygon class="led act" points={port.act}></polygon>
            </g>
          ))}
          <g class="slot" data-slot="sfp">
            <polygon class="bezel cage" points={art.sfp.cage}></polygon>
            <polygon class="socket" points={art.sfp.hole}></polygon>
            <polygon class="led link on" points={art.sfp.led}></polygon>
          </g>
        </svg>
        <div role="group" aria-label={t(lang, 'scene.router.ports')} class="ports">
          {art.ports.map((port, i) => (
            <button
              type="button"
              data-port={i}
              style={`left: ${port.left}%; top: ${port.top}%`}
              aria-label={`ether${i + 1}`}
              tabindex={i === 0 ? 0 : -1}
            ></button>
          ))}
          <button
            type="button"
            data-port="sfp"
            style={`left: ${art.sfp.left}%; top: ${art.sfp.top}%`}
            aria-label="sfp1"
            tabindex="-1"
          ></button>
        </div>
      </div>

      <canvas aria-hidden="true"></canvas>

      <div class="radius" data-radius>
        <svg viewBox="0 0 64 56" aria-hidden="true" focusable="false">
          <polygon class="rack-side" points="10,18 32,29 32,36 10,25"></polygon>
          <polygon class="rack-front" points="32,29 54,18 54,25 32,36"></polygon>
          <polygon class="rack-top" points="10,18 32,7 54,18 32,29"></polygon>
          <polygon class="rack-side" points="10,29 32,40 32,47 10,36"></polygon>
          <polygon class="rack-front" points="32,40 54,29 54,36 32,47"></polygon>
          <polygon class="rack-side" points="10,25 32,36 32,40 10,29"></polygon>
          <polygon class="rack-front" points="32,36 54,25 54,29 32,40"></polygon>
          <polygon class="led on" points="38,33 41,31.5 41,33 38,34.5"></polygon>
          <polygon class="led on" points="38,44 41,42.5 41,44 38,45.5"></polygon>
        </svg>
        <span class="name">{t(lang, 'scene.router.radius')}</span>
      </div>
      <span class="msg" data-msg aria-hidden="true"></span>

      <div role="group" aria-label={t(lang, 'scene.router.subscribers')} class="homes">
        {subscribers.map((s, i) => (
          <button
            type="button"
            class="home"
            data-sub={i}
            data-link={s.port}
            style={`left: ${s.left}%; top: ${s.top}%`}
            aria-pressed="false"
            aria-label={`${t(lang, 'scene.router.isolate')} ${i + 1}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <svg viewBox="0 0 48 46" aria-hidden="true" focusable="false">
              <polygon class="ground" points="24,44 45,33.5 24,23 3,33.5"></polygon>
              <polygon class="wall-l" points="11,24 24,30.5 24,41 11,34.5"></polygon>
              <polygon class="wall-r" points="24,30.5 37,24 37,34.5 24,41"></polygon>
              <polygon class="roof-l" points="8,24 24,32 24,10"></polygon>
              <polygon class="roof-r" points="24,32 40,24 24,10"></polygon>
            </svg>
            <span class="tag" aria-hidden="true">
              {t(lang, 'scene.router.isolir')}
            </span>
          </button>
        ))}
      </div>

      <div
        class="tip"
        data-tip
        data-sessions={t(lang, 'scene.router.sessions')}
        data-free={t(lang, 'scene.router.free')}
        data-uplink={t(lang, 'scene.router.uplink')}
        data-isolir={t(lang, 'scene.router.isolir')}
        hidden
      ></div>
    </SceneFrame>
  </div>

  <SceneFrame
    name="fiber"
    ratio="5 / 2"
    ratioNarrow="3 / 2"
    caption={t(lang, 'scene.fiber.caption')}
    class="mt-14"
  >
    <canvas aria-hidden="true" data-home={t(lang, 'scene.fiber.home')}></canvas>
  </SceneFrame>
</section>

<style>
  /* The case: a dark metal slab in the device colours of tokens.css, whose edge separates it from the card behind
     it in either theme. The lit LEDs are the signal colour of the rest of the page. */
  .router {
    --rt-socket: #060a15;
    --rt-bezel: #55678f;
    position: absolute;
    left: 22%;
    top: 5%;
    z-index: 1;
    width: 60%;
  }
  :global(:root:not([data-theme='light'])) .router {
    --rt-bezel: #7a95c6;
  }
  .router svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .shadow {
    fill: rgb(var(--ink-rgb) / 0.09);
  }
  .face {
    stroke: var(--device-edge);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .top {
    fill: var(--device-top);
  }
  .front {
    fill: var(--device-front);
  }
  .side {
    fill: var(--device-side);
  }
  .plate {
    fill: rgb(255 255 255 / 0.06);
    stroke: rgb(255 255 255 / 0.22);
    stroke-width: 0.8;
  }
  .vent {
    fill: rgb(0 0 0 / 0.35);
  }
  .bezel {
    fill: var(--rt-bezel);
    fill-opacity: 0.55;
  }
  .socket {
    fill: var(--rt-socket);
  }
  .cage {
    fill-opacity: 0.85;
  }
  .led {
    fill: rgb(255 255 255 / 0.2);
  }
  .led.on {
    fill: rgb(var(--net-signal-rgb));
  }
  .slot.hot .bezel {
    fill: none;
    stroke: var(--accent-text);
    stroke-width: 2.2;
    fill-opacity: 1;
  }
  .slot.hot .socket {
    fill: #0b1530;
  }

  /* Transparent buttons over the ports: they carry the keyboard focus; the highlight is drawn in the SVG. */
  .ports button {
    position: absolute;
    width: 1.5rem;
    height: 1.75rem;
    translate: -50% -50%;
    border-radius: 0.25rem;
    outline: none;
  }

  canvas {
    z-index: 2;
    pointer-events: none;
  }

  .radius {
    position: absolute;
    right: 6%;
    top: 7%;
    z-index: 3;
    display: grid;
    justify-items: center;
    width: 17%;
    color: var(--fg);
  }
  .radius svg {
    width: 100%;
    height: auto;
  }
  .rack-top,
  .rack-front,
  .rack-side {
    stroke: var(--device-edge);
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
  .rack-top {
    fill: var(--device-top);
  }
  .rack-front {
    fill: var(--device-front);
  }
  .rack-side {
    fill: var(--device-side);
  }
  .name {
    margin-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
  }
  /* The last RADIUS message, a tag beside the uplink cable the pulse travels on (the script places it). */
  .msg {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--outline);
    border-radius: 0.375rem;
    background: var(--surface);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    translate: -50% calc(-100% - 0.625rem);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .msg.show {
    opacity: 1;
  }

  .home {
    position: absolute;
    z-index: 3;
    display: grid;
    justify-items: center;
    width: 3.75rem;
    min-height: 3.5rem;
    translate: -50% -30%;
    border-radius: var(--radius);
    --wall-l: var(--surface-2);
    --wall-r: var(--line);
    --roof: rgb(var(--net-rgb));
    --stroke: var(--outline);
  }
  .home svg {
    width: 2.75rem;
    height: auto;
    transition: translate 160ms ease;
  }
  .ground {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }
  .wall-l,
  .wall-r,
  .roof-l,
  .roof-r {
    stroke: var(--stroke);
    stroke-width: 1;
    stroke-linejoin: round;
    transition:
      fill 200ms ease,
      stroke 200ms ease;
  }
  .wall-l {
    fill: var(--wall-l);
  }
  .wall-r {
    fill: var(--wall-r);
  }
  .roof-l {
    fill: rgb(var(--net-rgb) / 0.55);
  }
  .roof-r {
    fill: rgb(var(--net-rgb) / 0.8);
  }
  .home:hover svg,
  .home:focus-visible svg {
    translate: 0 -2px;
  }
  .home:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }
  .tag {
    margin-top: -0.125rem;
    color: rgb(var(--warn-rgb));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .home[aria-pressed='true'] .tag {
    opacity: 1;
  }
  .home[aria-pressed='true'] {
    --stroke: rgb(var(--warn-rgb));
  }
  .home[aria-pressed='true'] .roof-l {
    fill: rgb(var(--warn-rgb) / 0.4);
  }
  .home[aria-pressed='true'] .roof-r {
    fill: rgb(var(--warn-rgb) / 0.62);
  }

  .tip {
    position: absolute;
    z-index: 5;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--outline);
    border-radius: 0.375rem;
    background: var(--surface);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    translate: -50% calc(-100% - 0.75rem);
  }
  .tip[hidden] {
    display: none;
  }
</style>
